# ==========================================
# News Sentiment Analyzer — Environment Config
# ==========================================

# Application metadata & environment
APP_NAME="News Sentiment Analyzer"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=false

# Logging configuration
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# LOG_FORMAT: console (local development) or json (production/docker)
LOG_FORMAT=console

# Database persistence (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./news_sentiment.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/news_sentiment

# FastAPI server network binding
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173"]'

# News API Ingestion Keys (Phase 1)
# NEWSAPI_KEY=
# GUARDIAN_API_KEY=
